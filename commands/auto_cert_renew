#!/usr/bin/env bash
set -euo pipefail

# Certbot renewals are handled by systemd and /etc/letsencrypt renewal hooks.
# Do not install the legacy /root/renew_tls.sh cron job; it copied a selected
# lineage into ~/sslcerts and could overwrite NGINX with the wrong certificate.
sudo mkdir -p /etc/letsencrypt/renewal-hooks/deploy
sudo tee /etc/letsencrypt/renewal-hooks/deploy/reload-nginx.sh >/dev/null <<EOF
#!/usr/bin/env bash
set -euo pipefail
nginx -t
systemctl reload nginx
EOF
sudo chmod +x /etc/letsencrypt/renewal-hooks/deploy/reload-nginx.sh
sudo systemctl enable --now certbot.timer
